# ==============================================================================
# Sweety — Root Environment Configuration Template (.env.example)
# ==============================================================================
# Sweety is a Bun monorepo comprising:
#   - server/ (Express REST API + Prisma PostgreSQL)
#   - client/ (React + Vite + Tailwind CSS)
#
# Copy this file to:
#   - server/.env  (for backend server configuration)
#   - client/.env  (for frontend client configuration)
#
# IMPORTANT:
# - Never commit actual .env files containing real secrets to version control.
# - Both server/.env and client/.env are ignored in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Prisma) — used in server/.env
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL database used by Prisma ORM.
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
#
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweety?schema=public"
#
# Hosted Neon / Cloud PostgreSQL example:
# DATABASE_URL="postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweety?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Security (JWT) — used in server/.env
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (Bearer tokens).
# Must be a long, unpredictable random string of at least 32 characters in production.
JWT_SECRET="replace-with-a-secure-random-jwt-secret-min-32-chars"

# Expiration window for signed JWT access tokens (e.g. 15m, 1h, 7d, 30d).
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. Password Hashing (bcrypt) — used in server/.env
# ------------------------------------------------------------------------------
# Number of salt rounds for bcrypt password hashing. Default is 10.
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. Backend Server Port — used in server/.env
# ------------------------------------------------------------------------------
# Port on which the Express backend HTTP server listens.
PORT=5000

# Node environment mode: development | test | production
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 5. Frontend URL & CORS Configuration — used in server/.env
# ------------------------------------------------------------------------------
# Origin allowed to make cross-origin requests to the backend API.
# Used in server CORS middleware (cors({ origin: env.CLIENT_ORIGIN, credentials: true })).
CLIENT_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# 6. Cookie Configuration (If Applicable)
# ------------------------------------------------------------------------------
# NOTE: Cookies are NOT applicable in Sweety.
# Authentication is fully stateless using JWT access tokens passed via the
# HTTP request header: `Authorization: Bearer <token>`.
# No session or authentication cookies are used or required.

# ------------------------------------------------------------------------------
# 7. Optional Service Variables (Only If Used)
# ------------------------------------------------------------------------------
# NOTE: No external third-party services (such as Redis, Cloudinary, AWS S3,
# or email delivery services) are used in Sweety. All persistence is handled
# directly by PostgreSQL via Prisma.

# ------------------------------------------------------------------------------
# 8. Frontend Client Configuration — used in client/.env
# ------------------------------------------------------------------------------
# Base URL for the Express API used by the Axios client in the React frontend.
VITE_API_URL="http://localhost:5000/api"

