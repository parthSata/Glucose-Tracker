# ==============================================================================
# Sweety Frontend — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `client/.env` to configure your frontend environment.
# Note: `client/.env` is ignored by Git and should never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
# Points the Axios API client to the running Express backend API.
# Default development server runs on port 5000: http://localhost:5000/api
VITE_API_URL="http://localhost:5000/api"
