# ==============================================================================
# Sweety Backend — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `server/.env` to configure your backend environment.
# Note: `server/.env` is ignored by Git and should never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
#
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweety?schema=public"
#
# Hosted Neon / Cloud PostgreSQL:
# DATABASE_URL="postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweety?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (Bearer tokens).
# In production, use a high-entropy string of at least 32 characters.
JWT_SECRET="replace-with-a-secure-random-jwt-secret-min-32-chars"

# Token validity duration (e.g. 15m, 1h, 7d, 30d).
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. Password Hashing (bcrypt)
# ------------------------------------------------------------------------------
# Salt rounds for password hashing. Default is 10.
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. HTTP Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Express backend HTTP server listens.
PORT=5000

# Node environment mode: development | test | production
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 5. Frontend Origin & CORS Configuration
# ------------------------------------------------------------------------------
# Allowed origin for cross-origin browser requests (CORS middleware).
CLIENT_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# 6. Cookie Configuration (If Applicable)
# ------------------------------------------------------------------------------
# NOTE: Cookies are NOT applicable in Sweety.
# Authentication is stateless via `Authorization: Bearer <token>` headers.
# No session or authentication cookies are used or required.

# ------------------------------------------------------------------------------
# 7. Optional Service Variables (Only If Used)
# ------------------------------------------------------------------------------
# NOTE: No external services (Redis, Cloudinary, AWS S3, or Nodemailer) are used.
# All application data is stored directly in PostgreSQL via Prisma.
